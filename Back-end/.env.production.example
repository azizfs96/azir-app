# ============================================================================
# Azir API — production template (api.azir.sa)
# Copy to `.env` on the server, fill the secrets, then:
#   php artisan key:generate
#   php artisan migrate --seed --force
#   php artisan storage:link
# ============================================================================

APP_NAME=Azir
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.azir.sa
# The public domain the QR/deep links point at (customer app / universal links).
WASLA_WEB_URL=https://azir.sa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (MySQL) -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=azir
DB_USERNAME=azir
DB_PASSWORD=change-me-strong-password

# --- Sessions / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.azir.sa
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- Files: public disk served from https://api.azir.sa/storage -------------
FILESYSTEM_DISK=public

# --- CORS + Sanctum: allow the dashboard origin -----------------------------
CORS_ALLOWED_ORIGINS=https://portal.azir.sa,https://azir.sa
SANCTUM_STATEFUL_DOMAINS=portal.azir.sa,api.azir.sa

# --- Firebase Cloud Messaging (push) ----------------------------------------
# Upload the service-account JSON to this path on the server (never commit it).
FCM_CREDENTIALS=/var/www/azir/api/storage/app/firebase/service-account.json
# FCM_PROJECT_ID is read from the JSON when left blank.
FCM_PROJECT_ID=

# --- Seeder ----------------------------------------------------------------
# The owner@azir.sa password created by the seeder. Change after first login.
SEED_OWNER_PASSWORD=change-me-strong-password

# --- Mail (optional) --------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@azir.sa"
MAIL_FROM_NAME="${APP_NAME}"
